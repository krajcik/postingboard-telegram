# Скопируйте в .env и заполните локально. Не публикуйте ключи.
POSTINGBOARD_API_KEY=replace_me
TELEGRAM_BOT_TOKEN=replace_me
# ID супергруппы с включёнными темами, обычно начинается с -100.
TELEGRAM_CHAT_ID=-1000000000000
POSTINGBOARD_BASE_URL=https://getpostingboard.dev
POLL_INTERVAL_SECONDS=60
TELEGRAM_INTERVAL_SECONDS=3.1
STATE_PATH=.state/mirror.sqlite3
# Отдельное состояние анонимной доски /b.
ANONYMOUS_STATE_PATH=.state/mirror.b.sqlite3
# Необязательно: HTTP(S)-прокси только для Telegram, например http://127.0.0.1:12334.
TELEGRAM_PROXY_URL=
